# Database
DATABASE_URL="postgresql://username:password@localhost:5432/touchwood"
# For development, you can use SQLite:
# DATABASE_URL="file:./dev.db"

# Public site origin — drives canonical URLs, sitemap, robots and OG tags.
# Must be the real production origin. Do NOT point this at a preview deploy.
NEXT_PUBLIC_SITE_URL="https://touchwoodasset.com"

# NextAuth
NEXTAUTH_URL="http://localhost:3000"
NEXTAUTH_SECRET="your-secret-key-here"

# Email (Resend)
RESEND_API_KEY="your-resend-api-key"
ENQUIRY_INBOX="enquiries@touchwood.com.au"

# File Upload (UploadThing)
UPLOADTHING_SECRET="your-uploadthing-secret"
UPLOADTHING_APP_ID="your-uploadthing-app-id"

# Maps (Mapbox - optional, fallback to static maps)
NEXT_PUBLIC_MAPBOX_TOKEN="your-mapbox-token"

# Analytics — GA4 only loads when this is set.
NEXT_PUBLIC_GA_MEASUREMENT_ID="G-XXXXXXXXXX"

# Google Search Console "HTML tag" verification token (the content value only).
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=""

# Meta (Facebook/Instagram) Pixel. Found in Events Manager > Data Sources.
# The pixel only loads when this is set, so previews never fire conversions.
NEXT_PUBLIC_META_PIXEL_ID=""

# Form submissions → Google Sheets (Apps Script web app).
# REQUIRED in production: contact, valuation, inspection and /property-review
# forms all post through /api/sheets-webhook, which returns 500 if this is unset.
# See GOOGLE_APPS_SCRIPT_SETUP.md. Secret must match the one in the Apps Script.
SHEETS_WEBHOOK="https://script.google.com/macros/s/YOUR_SCRIPT_ID/exec"
FORM_SHARED_SECRET="your-long-random-secret-string"

# Spam Protection
HCAPTCHA_SITE_KEY="your-hcaptcha-site-key"
HCAPTCHA_SECRET_KEY="your-hcaptcha-secret-key"

# Google Business Profile
NEXT_PUBLIC_GOOGLE_BUSINESS_PROFILE_URL="https://business.google.com/your-business"

# Social Media
NEXT_PUBLIC_FACEBOOK_URL="https://facebook.com/touchwood"
NEXT_PUBLIC_LINKEDIN_URL="https://linkedin.com/company/touchwood"
NEXT_PUBLIC_INSTAGRAM_URL="https://instagram.com/touchwood"

# Company Info
NEXT_PUBLIC_COMPANY_NAME="Touchwood Asset Management"
NEXT_PUBLIC_COMPANY_PHONE="+61 2 1234 5678"
NEXT_PUBLIC_COMPANY_EMAIL="info@touchwood.com.au"
NEXT_PUBLIC_COMPANY_ADDRESS="123 Business Street, Sydney NSW 2000"
